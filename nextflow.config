// =============================================================================
// ONT Sequencing Pipeline – nextflow.config
// =============================================================================

params {
    // --- Required ---
    input_dir    = null
    results_file = 'results.tsv'

    // --- Database paths (required) ---
    kraken_db      = null
    resfinder_db   = null

    // --- Database paths (optional) ---
    checkm2_env    = null
    flye_env       = null
    flye_bin       = null
    checkm2_db     = null        // auto-downloaded if null
    busco_lineage  = 'bacteria_odb10'
    mlst_scheme    = null        // null = auto-detect
    amrfinder_db       = null    // the conda package ships no db — amrfinder_update -d <dir>
    amrfinder_organism = null

    // --- Output ---
    outdir = 'results'

    // --- SGE array job support ---
    sample_name        = null   // process only this sample (set by array task)
    sample_list        = null   // file of sample names; listed samples are reprocessed
                                // even if already in results_file
    skip_write_results = false  // set true in array tasks

    // --- MALDI-TOF contamination detection (optional) ---
    maldi_csv          = null   // CSV with columns: "UCL ID", "Species UCL MALDI"

    // --- Kraken2 ---
    kraken_memory_mapping = false  // set true if Kraken2 fails to allocate DB into RAM

    // --- Read filtering ---
    filtlong_min_length  = 100
    // Assembly input only — CALC_DEPTH maps the full read set, so Chr_Mean_Depth
    // is unaffected.
    filtlong_target_bases = 750000000

    // null = let Flye estimate per sample. Setting it enables --asm-coverage,
    // which only caps the disjointig stage.
    flye_genome_size   = null
    flye_asm_coverage  = 50    // ignored unless flye_genome_size is set
    flye_iterations    = 1

    // Move chromosome-assigned contigs carrying only a relaxase into the plasmid
    // set. Read depth is deliberately not a criterion: plasmid and chromosome
    // coverage are not reliably separated in these libraries.
    mge_rescue    = true

    // At or above this length an off-genus contig is discarded rather than kept
    // for AMR screening, being more likely a second chromosome than an element.
    mge_max_len   = 1000000

    // Below either threshold the assembly is kept intact and Maldi_contigs_used
    // is set to 'Mismatch', rather than filtering away the genome.
    maldi_min_genus_len  = 1000000   // bp of MALDI-genus contigs
    maldi_min_genus_frac = 0.25      // fraction of total assembly length

    // --- Resource limits ---
    max_memory = '64.GB'
    max_cpus   = 16
    max_time   = '72.h'

    // --- Conda ---
    use_mamba  = true
}

// ---------------------------------------------------------------------------
// Process labels
// ---------------------------------------------------------------------------
process {
    errorStrategy = 'ignore'
    maxErrors     = -1

    withLabel: 'process_low' {
        cpus   = { Math.max(1, (params.max_cpus as int).intdiv(4)) }
        memory = { Math.max(1L, (params.max_memory as nextflow.util.MemoryUnit).toGiga().intdiv(4)).GB }
        time   = '2.h'
    }
    withLabel: 'process_medium' {
        cpus   = { Math.max(1, (params.max_cpus as int).intdiv(2)) }
        memory = { Math.max(1L, (params.max_memory as nextflow.util.MemoryUnit).toGiga().intdiv(2)).GB }
        time   = '12.h'
    }
    withLabel: 'process_high' {
        cpus   = { params.max_cpus as int }
        memory = { params.max_memory as nextflow.util.MemoryUnit }
        time   = '24.h'
    }

    // Force the active conda env's bin ahead of system python.
    beforeScript = 'export PATH="${CONDA_PREFIX:+${CONDA_PREFIX}/bin:}${projectDir}/bin:${PATH}"'
}

// ---------------------------------------------------------------------------
// Conda
// ---------------------------------------------------------------------------
conda.enabled  = true
conda.useMamba = params.use_mamba
conda.cacheDir = System.getenv('NXF_CONDA_CACHEDIR') ?: "${projectDir}/.conda_envs"

conda.createOptions = '--channel-priority flexible'

// ---------------------------------------------------------------------------
// Execution profiles
// ---------------------------------------------------------------------------
profiles {

    standard {
        process.executor = 'local'
        executor {
            cpus   = params.max_cpus
            memory = params.max_memory
        }
    }

    macstudio {
        process.executor = 'local'
        conda.enabled    = true
        conda.useMamba   = true

        params.max_cpus   = 4
        params.max_memory = 40.GB

        executor {
            cpus      = 20        // performance cores
            memory    = 230.GB
            queueSize = 60
        }

        // Using the cluster's 8 GB capped DB so results stay comparable between
        // machines. Set true if switching to the full ~200 GB database.
        params.kraken_memory_mapping = false

        // Measured per-process requests. withName takes precedence over
        // withLabel, whose process_high tier would reserve max_memory for every
        // heavy process and cap concurrency at 5 tasks.
        process {
            withName: 'FLYE'        { cpus = 4; memory = 16.GB }
            withName: 'CHECKM2_.*'  { cpus = 2; memory = 20.GB }
            withName: 'BUSCO'       { cpus = 2; memory = 8.GB  }
            withName: 'KRAKEN2_.*'  { cpus = 2; memory = 12.GB }
        }
    }

    sge {
        process.executor = 'sge'
        process.penv     = 'smp'

        // -V  : pass the submitter's environment to every job
        // -R y: resource reservation
        process {
            withLabel: 'process_low' {
                clusterOptions = {
                    def m = Math.max(1L, (task.memory.toGiga() / task.cpus).longValue())
                    "-V -R y -l tmem=${m}G,h_vmem=${m}G"
                }
            }
            withLabel: 'process_medium' {
                clusterOptions = {
                    def m = Math.max(1L, (task.memory.toGiga() / task.cpus).longValue())
                    "-V -R y -l tmem=${m}G,h_vmem=${m}G"
                }
            }
            withLabel: 'process_high' {
                clusterOptions = {
                    def m = Math.max(1L, (task.memory.toGiga() / task.cpus).longValue())
                    "-V -R y -l tmem=${m}G,h_vmem=${m}G"
                }
            }
        }

        executor {
            queueSize    = 200
            pollInterval = '30 sec'
            submitRateLimit = '10 sec'
        }
    }

    lsf {
        process.executor = 'lsf'
        process {
            withLabel: 'process_high' {
                queue = 'long'
                clusterOptions = '-R "rusage[mem=32000]"'
            }
        }
    }

    docker {
        docker.enabled   = true
        conda.enabled    = false
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        conda.enabled          = false
    }

    test {
        params.input_dir    = 'test_data/input'
        params.results_file = 'test_data/results.tsv'
        params.kraken_db    = 'test_data/kraken_db'
        params.resfinder_db = 'test_data/resfinder_db'
        params.busco_lineage = 'bacteria_odb10'
        process {
            withLabel: 'process_high'   { cpus = 2; memory = '4.GB' }
            withLabel: 'process_medium' { cpus = 2; memory = '4.GB' }
            withLabel: 'process_low'    { cpus = 1; memory = '2.GB' }
        }
    }
}

// ---------------------------------------------------------------------------
// Reporting
// ---------------------------------------------------------------------------
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_report.html"
    overwrite = true
}
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_timeline.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_trace.txt"
    overwrite = true
}

// ---------------------------------------------------------------------------
// Manifest
// ---------------------------------------------------------------------------
manifest {
    name            = 'ONT Sequence Analysis Pipeline'
    description     = 'Per-barcode ONT QC, assembly, AMR, and typing pipeline'
    version         = '1.0.0'
    nextflowVersion = '>=23.04.0'
}
